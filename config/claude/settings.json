{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(yarn *)",
      "Bash(npm *)",
      "Bash(bun *)",
      "Bash(pnpm *)",
      "Bash(cargo *)",
      "Bash(rustc *)",
      "Bash(anchor *)",
      "Bash(solana *)",
      "Bash(pip *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(touch *)",
      "Bash(echo *)",
      "Bash(curl *)",
      "Bash(open *)",
      "Bash(defuddle parse *)",
      "Bash(claude mcp *)",
      "WebSearch",
      "Skill(update-config)",
      "Read(/Users/bry/.claude/plugins/cache/claude-plugins-official/**)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:developers.googleblog.com)"
    ],
    "deny": [
      "Read(.env*)",
      "Bash(rm -rf *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(npm publish *)",
      "Bash(yarn publish *)",
      "Bash(cargo publish *)",
      "Bash(bun publish *)",
      "Bash(docker push *)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-destructive-git.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'jq -r .tool_input.file_path | xargs npx prettier --write 2>/dev/null || true'"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/check-comments.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/tmux/pulse-start.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c '\"/Users/bry/.bun/bin/bun\" \"$(ls -td ~/.claude/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | head -1)src/index.ts\"'"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "plannotator@plannotator": false,
    "claude-hud@claude-hud": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "effortLevel": "medium",
  "autoCompactWindow": 180000,
  "prefersReducedMotion": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "verbose": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults"
    ],
    "allow": [
      "$defaults",
      "PR review submission: submitting a GitHub pull request review with `gh pr review` (approve or comment) or `gh api repos/<owner>/<repo>/pulls/<n>/reviews` (APPROVE or COMMENT event) is allowed. It is the output of the user's /review skill, publishes only review text and code suggestions to a repo the user already has push access to, and changes no branch or file."
    ]
  }
}
